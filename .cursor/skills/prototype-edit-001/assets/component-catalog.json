{
  "version": "2026-06-23",
  "components": [
    {
      "id": "filter-select",
      "tier": "page-edit",
      "label": "下拉筛选",
      "category": "filter",
      "description": "标签 + 单选下拉，占位选项，符合列表页筛选区宽度规范。",
      "defaults": {
        "label": "新筛选项",
        "options": ["全部", "选项A", "选项B"],
        "placeholder": "请选择"
      },
      "mountSelectors": [".filter-grid", ".filter-panel .filter-grid", "section.filters", ".filters"]
    },
    {
      "id": "filter-text",
      "tier": "page-edit",
      "label": "文本筛选",
      "category": "filter",
      "description": "标签 + 文本输入框。",
      "defaults": {
        "label": "关键词",
        "inputPlaceholder": "请输入"
      },
      "mountSelectors": [".filter-grid", ".filter-panel .filter-grid", "section.filters", ".filters"]
    },
    {
      "id": "filter-month-placeholder",
      "tier": "page-edit",
      "label": "月份范围（占位）",
      "category": "filter",
      "description": "仅插入占位容器；页面已引 month-range-picker.js 时可后续在源 HTML 中初始化。",
      "defaults": {
        "label": "月份范围"
      },
      "mountSelectors": [".filter-grid", ".filter-panel .filter-grid"]
    },
    {
      "id": "toolbar-button",
      "tier": "page-edit",
      "label": "工具栏按钮",
      "category": "button",
      "description": "展示用按钮，无默认点击逻辑。",
      "defaults": {
        "text": "新按钮",
        "variant": "default"
      },
      "mountSelectors": [".toolbar", ".jd-card-hd", ".page-actions", ".filter-panel"]
    },
    {
      "id": "table-column-text",
      "tier": "page-edit",
      "label": "表格文本列",
      "category": "column",
      "description": "在表头末追加列，并为现有行补单元格；mock 字段可填。",
      "defaults": {
        "header": "新列",
        "mockField": "newCol",
        "defaultValue": "—"
      },
      "mountSelectors": ["table.data-table", "table.jd-table", "#mainTable", "section.content table", ".table-wrap table"]
    },
    {
      "id": "form-field-text",
      "tier": "page-edit",
      "label": "表单文本字段",
      "category": "form",
      "description": "在 .form-grid 或 .field 容器中追加一项。",
      "defaults": {
        "label": "新字段",
        "placeholder": "请输入",
        "required": false
      },
      "mountSelectors": [".form-grid", ".modal-bd", ".entry-form"]
    }
  ]
}
