    {
      "id": "mmufd2noqnfs94h6nrk",
      "type": "text",
      "x": 115,
      "y": 975,
      "width": 893.5498657226562,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
