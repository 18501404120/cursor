      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aP",
      "roundness": null,
      "seed": 140278572,
      "version": 1,
      "versionNonce": 678077228,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1773741006924,
      "link": null,
      "locked": false,
      "text": "估算规则（第一版）\n- 取不到（平台赔偿/服务费/运杂费等）或不及时（税/退款/关税滚动）：用‘财务历史占比（上月/近12月）× 可得基数（发货销售额/销售额）’\n- 先跑 1~2 个月：标红偏差最大的项 → 第二轮再补接口/修口径\n- 重要提醒：折扣/费用归集要避免重复扣减（可能被放在推广费/广告费等其他项里）",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "估算规则（第一版）\n- 取不到（平台赔偿/服务费/运杂费等）或不及时（税/退款/关税滚动）：用‘财务历史占比（上月/近12月）× 可得基数（发货销售额/销售额）’\n- 先跑 1~2 个月：标红偏差最大的项 → 第二轮再补接口/修口径\n- 重要提醒：折扣/费用归集要避免重复扣减（可能被放在推广费/广告费等其他项里）",
      "autoResize": true,
      "lineHeight": 1.25,
      "syncedAt": "2026-03-17T09:50:20.278Z",
      "source": "frontend_sync",
      "syncTimestamp": "2026-03-17T09:50:20.275Z"
    },
