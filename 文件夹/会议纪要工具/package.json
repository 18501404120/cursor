{
  "name": "meeting-recorder",
  "version": "1.0.0",
  "private": true,
  "description": "macOS 线下会议录音 + FunASR 本地转写（悬浮窗）",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "setup:python": "bash scripts/setup-python.sh",
    "download:models": "bash scripts/download-models.sh",
    "scenario:from-txt": "node scripts/generate-scenario-from-txt.js",
    "retranscribe:m4a": "node scripts/retranscribe-from-m4a.js",
    "generate:icon": "python3 scripts/generate-icon.py",
    "install:desktop": "bash scripts/install-desktop.sh",
    "force-quit": "bash scripts/force-quit.sh",
    "postinstall": "node scripts/check-deps.js"
  },
  "dependencies": {
    "electron": "^33.2.0",
    "ffmpeg-static": "^5.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
