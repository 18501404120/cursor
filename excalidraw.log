2026-03-17 18:53:49.129 [debug] Syncing to canvas: batch_create {"url":"http://localhost:3000/api/elements/batch","data":[{"id":"mmuhvhe15forke12e78","type":"text","x":80,"y":30,"strokeColor":"#111827","text":"全渠道报表相关讨论｜单页图文总结（One-pager）","fontSize":26,"createdAt":"2026-03-17T10:53:49.129Z","updatedAt":"2026-03-17T10:53:49.129Z","version":1},{"id":"mmuhvhe1wjjyqf5hhsd","type":"rectangle","x":80,"y":75,"width":920,"height":95,"backgroundColor":"#E0F2FE","strokeColor":"#0284C7","createdAt":"2026-03-17T10:53:49.129Z","updatedAt":"2026-03-17T10:53:49.129Z","version":1},{"id":"mmuhvhe1eed41e59kil","type":"text","x":105,"y":95,"text":"一句话结论：先做 GTM 口径可对齐看板，用「销售额→营收→毛利」链路拆开差异；当月财务缺值时只展示占比 Benchmark，取不到用占比估算先跑 1~2 月再迭代。","fontSize":16,"createdAt":"2026-03-17T10:53:49.129Z","updatedAt":"2026-03-17T10:53:49.129Z","version":1},{"id":"mmuhvhe1z1bo0977158","type":"text","x":80,"y":195,"strokeColor":"#111827","text":"关键规则","fontSize":18,"createdAt":"2026-03-17T10:53:49.129Z","updatedAt":"2026-03-17T10:53:49.129Z","version":1},{"id":"mmuhvhe1ewpgif8de","type":"rectangle","x":80,"y":220,"width":440,"height":200,"backgroundColor":"#FEF3C7","strokeColor":"#F59E0B","createdAt":"2026-03-17T10:53:49.129Z","updatedAt":"2026-03-17T10:53:49.129Z","version":1},{"id":"mmuhvhe1s2pourvdldo","type":"text","x":105,"y":245,"text":"· 展示：从上往下推 Sales→Net→GP，每步扣减项拆开\n· 财务缺值：只保留占比 Benchmark（上月/近3月）\n· 取数：取不到用财务占比×可得基数估算\n· 明细：值+占比两行；趋势图只放核心指标","fontSize":14,"createdAt":"2026-03-17T10:53:49.129Z","updatedAt":"2026-03-17T10:53:49.129Z","version":1},{"id":"mmuhvhe1hyzv3hw07dw","type":"text","x":80,"y":445,"strokeColor":"#111827","text":"风险与待办","fontSize":18,"createdAt":"2026-03-17T10:53:49.129Z","updatedAt":"2026-03-17T10:53:49.129Z","version":1},{"id":"mmuhvhe15ckt7xx6pme","type":"rectangle","x":540,"y":220,"width":460,"height":200,"backgroundColor":"#ECFDF5","strokeColor":"#10B981","createdAt":"2026-03-17T10:53:49.129Z","updatedAt":"2026-03-17T10:53:49.129Z","version":1},{"id":"mmuhvhe1hfie2s0dp3e","typ