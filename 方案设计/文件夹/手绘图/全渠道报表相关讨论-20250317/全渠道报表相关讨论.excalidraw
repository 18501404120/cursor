    },
    {
      "id": "mmulc1u7bc6d3qb7j7",
      "type": "text",
      "x": 525,
      "y": 655,
      "text": "P0:固化扣减项与财务映射;仅占比Benchmark;核验Amazon discount\nP1:退款接口;头程尾程误差验证;Offline口径对齐\nP2:异常项标红+备注",
      "fontSize": 13,
      "createdAt": "2026-03-17T12:30:40.983Z",
      "updatedAt": "2026-03-17T12:30:40.983Z",
      "version": 1,
      "fontFamily": 1
    }
