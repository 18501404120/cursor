      "roughness": 2
    },
    {
      "id": "mmulc1u74erdvf3btmq",
      "type": "text",
      "x": 535,
      "y": 485,
      "text": "Amazon:订单补税/运费;核验discount;退款用退货率估算\n独立站/APP:净额上加回税/退货得销售额\n商超/Offline:全月/全年加权占比\n分销:整单折扣与PI/前返对齐;税按订单",
      "fontSize": 12,
      "createdAt": "2026-03-17T12:30:40.983Z",
      "updatedAt": "2026-03-17T12:30:40.983Z",
      "version": 1,
      "fontFamily": 1
    },
    {
      "id": "mmulc1u76cr0fuvnooa",
      "type": "text",
      "x": 60,
      "y": 610,
