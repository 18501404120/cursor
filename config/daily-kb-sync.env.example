# Copy this file to daily-kb-sync.env and fill local-only values.
# Do not commit or share the real API key.

CURSOR_API_KEY=

# Comma-separated ERP_product system directories maintained by this local job.
ERP_DAILY_KB_SYSTEMS=分销系统,销售系统,自营系统,商超系统,GTM系统

# GitHub Token for auto-creating PRs (needs repo scope).
GITHUB_TOKEN=

# After KB sync, auto-push changes to system branches and create PRs.
ERP_KB_PUSH_ENABLED=true

# Local run settings.
ERP_DAILY_KB_MODEL=composer-2.5
ERP_DAILY_KB_NODE_VERSION=22
ERP_DAILY_KB_WINDOW_START=1230
ERP_DAILY_KB_WINDOW_END=1245

# Monthly full validation sync.
# The daily scheduler starts trying on this day each month.
# If the computer is off or the run fails, it retries at 12:30 on following days until success.
ERP_MONTHLY_FULL_SYNC_ENABLED=true
ERP_MONTHLY_FULL_SYNC_DAY=11

# Token-saving impact plan limits.
ERP_DAILY_KB_MAX_FILES_PER_SYSTEM=25
ERP_DAILY_KB_MAX_DIFF_LINES_PER_FILE=80
